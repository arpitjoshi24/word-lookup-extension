{
  "manifest_version": 3,
  "name": "Word Lookup — Synonyms & Antonyms",
  "version": "1.0.0",
  "description": "Look up synonyms and antonyms for any word, instantly.",
  "action": {
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "permissions": ["storage"],
  "host_permissions": [
    "https://api.datamuse.com/*"
  ],
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
